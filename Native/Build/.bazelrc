# macOS Apple Silicon 기본 설정
common --enable_bzlmod
common --experimental_repository_downloader_retries=5

build --repo_env=RULES_PYTHON_IGNORE_ROOT_USER_ERROR=1
build --cpu=darwin_arm64
build --apple_platform_type=macos
build --macos_minimum_os=10.16
build --define=MEDIAPIPE_DISABLE_GPU=1
# Holistic 양자화 모델이 Apple Silicon XNNPACK SME/SME2 커널에서 SIGILL로 죽으므로 제외 (NEON/I8MM/DotProd 유지)
build --define=xnn_enable_arm_sme=false
build --define=xnn_enable_arm_sme2=false

# MediaPipe v1.0.0의 api3/node는 consteval을 사용하므로 C++20 필요
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# 경고 억제, visibility 제어
build --copt=-w
build --copt=-fvisibility=hidden
